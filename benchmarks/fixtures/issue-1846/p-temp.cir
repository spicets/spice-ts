MOS9 instance temperature p-temp
VD supply 0 -3
VG g 0 -2
VB b 0 0.4
RD supply d 1k
RS s 0 100
M1 d g s b MOD L=2u W=10u AD=2p AS=3p TEMP=75
.model MOD PMOS LEVEL=9 VTO=-0.7 KP=1e-4 GAMMA=0.4 PHI=0.6 THETA=0.1 ETA=0.02 KAPPA=0.2 VMAX=1e5 TOX=20n IS=1e-14 JS=1e-8
.options TEMP=40 RELTOL=1e-10 ABSTOL=1e-15 VNTOL=1e-12
.op
.dc VG 0 -3 -0.05
.control
set filetype=ascii
.endc
.end
