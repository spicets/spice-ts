{
  "name": "@spice-ts/circuit-json",
  "version": "0.3.1",
  "description": "Bidirectional circuit-json adapter for spice-ts Circuit IR",
  "license": "MIT",
  "author": "Mattia Fiumara",
  "repository": {
    "type": "git",
    "url": "https://github.com/spicets/spice-ts.git",
    "directory": "packages/circuit-json"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "test": "vitest run && pnpm test:packed-consumer",
    "test:coverage": "vitest run && pnpm test:packed-consumer",
    "test:packed-consumer": "pnpm build && node scripts/packed-consumer.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@spice-ts/core": "workspace:*",
    "circuit-json": "^0.0.525",
    "zod": "3"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  }
}
