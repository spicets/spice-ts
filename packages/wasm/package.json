{
  "name": "@spice-ts/wasm",
  "private": true,
  "version": "0.4.0",
  "description": "Protocol-v1 module-worker facade for spice-ts",
  "license": "MIT",
  "author": "Mattia Fiumara",
  "repository": {
    "type": "git",
    "url": "https://github.com/spicets/spice-ts.git",
    "directory": "packages/wasm"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./manifest": "./dist/manifest.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsx scripts/build.ts",
    "pretest": "pnpm build",
    "test": "vitest run && pnpm test:readme-losses && pnpm test:packed-consumer",
    "test:readme-losses": "tsx --test ../../benchmarks/results/issue-355/readme-losses.test.ts ../../benchmarks/results/issue-362/readme-losses.test.ts",
    "test:packed-consumer": "pnpm build && node scripts/packed-consumer.mjs",
    "bench:ac": "pnpm build && tsx scripts/ac-accuracy.ts",
    "bench:vccs-op": "pnpm build && tsx ../../benchmarks/wasm-vccs-op/compare.ts",
    "bench:cccs-op": "pnpm build && tsx ../../benchmarks/wasm-cccs-op/compare.ts",
    "bench:vcvs-op": "pnpm build && tsx ../../benchmarks/results/issue-355/compare.ts",
    "bench:ccvs-op": "pnpm build && tsx ../../benchmarks/results/issue-362/compare.ts",
    "bench:rlc-tran": "pnpm build && tsx ../../benchmarks/results/issue-368/compare.ts",
    "bench:dc": "pnpm build && tsx ../../benchmarks/wasm-dc-sweep/compare.ts",
    "test:coverage": "pnpm build && vitest run --coverage --exclude src/browser.smoke.test.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@spice-ts/core": "workspace:*",
    "ajv": "^8.17.1"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "@types/ws": "^8.18.2",
    "@vitest/coverage-v8": "^4.1.4",
    "tsx": "^4.21.0",
    "tsup": "^8.0.0",
    "typescript": "^5.4.0",
    "vite": "^8.0.8",
    "vitest": "^4.1.4",
    "ws": "^8.22.0"
  }
}
