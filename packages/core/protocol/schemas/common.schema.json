            "nextCursor": {
              "const": null
            },
            "terminal": {
              "$ref": "#/$defs/successEnvelope"
            }
          },
          "additionalProperties": false
        },
        {
          "type": "object",
          "required": [
            "status",
            "events",
            "nextCursor",
            "terminal"
