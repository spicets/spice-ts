            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/simulationEvent"
              }
            },
            "nextCursor": {
              "const": null
            },
            "terminal": {
              "$ref": "#/$defs/failureTerminal"
            }
          },
          "additionalProperties": false
        }
